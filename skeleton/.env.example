# 복사해서 .env 로. 비밀값은 여기만. .env 는 git에 넣지 않는다.
AGENT_IMAGE=agent:0.2.0                      # 고객사: harbor.corp.local/ax/agent:0.2.0
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-v1.55.8
POSTGRES_IMAGE=postgres:16.4-alpine
NGINX_IMAGE=nginx:1.27-alpine
SQUID_IMAGE=ubuntu/squid:5.2-22.04_beta
PUBLIC_PORT=8080
ADMIN_PORT=4000
LLM_MODEL=gpt-4o-mini
LOG_LEVEL=INFO
GATEWAY_KEY=change-me-gateway-key
OPENAI_API_KEY=sk-replace-me                 # 또는 AZURE_API_KEY 등, gateway/config.yaml 참고
DB_PASSWORD=change-me
RO_DB_PASSWORD=change-me-ro
AUDIT_DB_PASSWORD=change-me-audit
UI_USERNAME=admin
UI_PASSWORD=change-me-ui
